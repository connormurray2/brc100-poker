  "dependencies": {
    "runar-compiler": "file:contracts/vendor/runar/runar-compiler-1.0.0-rc.1.tgz",
    "runar-ir-schema": "file:contracts/vendor/runar/runar-ir-schema-1.0.0-rc.1.tgz",
    "runar-lang": "file:contracts/vendor/runar/runar-lang-1.0.0-rc.1.tgz",
    "runar-sdk": "file:contracts/vendor/runar/runar-sdk-1.0.0-rc.1.tgz",
    "runar-testing": "file:contracts/vendor/runar/runar-testing-1.0.0-rc.1.tgz"
